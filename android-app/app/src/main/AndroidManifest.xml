<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ses dinleme (uyanma kelimesi + komutlar) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- AI saglayicilarina (Groq/DeepSeek/OpenRouter) ve hava/dolar/altin icin -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Surekli calisan arka plan servisi (bidarbash dinleme) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Telefon acilinca otomatik baslasin -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Fener -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <!-- Konum ozelligi (opsiyonel modul - sonraki asamada) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Hatirlatma sistemi: tam zamanli alarm -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- SMS gonderme komutu -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Guvenlik modu: hareket algilama -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Eda"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- Dashboard — eda.py dashboard() karsiligi -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false"
            android:label="EDA Dashboard" />

        <!-- Control Panel — WebView + NanoHTTPD -->
        <activity
            android:name=".panel.PanelActivity"
            android:exported="false"
            android:label="EDA Panel"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name=".service.EdaForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.ReminderReceiver"
            android:exported="false" />


        <!-- Telefonu kilitleme icin Device Admin Receiver -->
        <receiver
            android:name=".receiver.EdaDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>


        <!-- Home Screen Widget — Termux:Widget karsiligi -->
        <receiver
            android:name=".widget.EdaWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>

</manifest>
