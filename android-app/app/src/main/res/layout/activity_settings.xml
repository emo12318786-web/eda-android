<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/geriButon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="←"
                android:textSize="26sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:background="@drawable/circle_bg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ayarlar"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <Button
            android:id="@+id/izinMerkeziButon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="İZİN MERKEZİ — 27 İZİN"
            android:layout_marginBottom="16dp" />


        <!-- CARD: Harici mikrofon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_settings"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Harici Mikrofon"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mikrofonDurum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ses girişleri aranıyor…"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/mikrofonTaraButon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cihazları Tara" />

            <Button
                android:id="@+id/mikrofonSecButon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mikrofon Seç" />

            <Button
                android:id="@+id/mikrofonTestButon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mikrofonu Test Et" />

            <ProgressBar
                android:id="@+id/mikrofonSeviye"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="100"
                android:progress="0"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/mikrofonTestDurum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test için mikrofon seç ve konuş."
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not: Android'in sistem konuşma tanıyıcısı bazı cihazlarda giriş yönlendirmesini kendi yönetir. Bu test, seçilen girişe ses alınabildiğini kontrol eder."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- CARD: Kullanıcı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_settings"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤  HİTAP ŞEKLİ"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/purple_end"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/kullaniciAdiInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Eda sana hangi isimle hitap etsin? (ör: Deniz)"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp"
                android:inputType="text"
                android:backgroundTint="@color/purple_start" />
        </LinearLayout>

        <!-- CARD: API Keys -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_settings"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑  API ANAHTARLARI"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/purple_end"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/groqInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Groq API (gsk_...)"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp"
                android:inputType="text"
                android:backgroundTint="@color/purple_start"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/navasanInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Navasan API (dolar/altın)"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp"
                android:inputType="text"
                android:backgroundTint="@color/purple_start" />
        </LinearLayout>

        <!-- CARD: Sohbet hafızası; deliberately separated from phone permissions/toggles. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_settings"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠  SOHBET HAFIZASI"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/purple_end"
                android:layout_marginBottom="8dp" />

            <Switch
                android:id="@+id/conversationHistorySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Son konuşmaları hatırla"
                android:textColor="@color/text_primary"
                android:paddingVertical="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Açıkken EDA son konuşma mesajlarını bu cihazda sınırlı olarak saklar ve devam sorularında seçili AI sağlayıcısına gönderir. Kapalıyken kayıtlı konuşma bağlamı silinir."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- CARD: Telefon duyuruları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_settings"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱  TELEFON DUYURULARI"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/purple_end"
                android:layout_marginBottom="12dp" />

            <Switch
                android:id="@+id/smsAnnouncementSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Yeni mesaj geldi duyurusu"
                android:textColor="@color/text_primary"
                android:paddingVertical="8dp" />

            <Switch
                android:id="@+id/smsTranslationSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mesajı Türkçeye çevirip sesli oku"
                android:textColor="@color/text_primary"
                android:paddingVertical="8dp" />

            <Switch
                android:id="@+id/incomingCallSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gelen aramayı sesli duyur"
                android:textColor="@color/text_primary"
                android:paddingVertical="8dp" />

            <Switch
                android:id="@+id/sherpaWakeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sherpa-ONNX ana motoru"
                android:textColor="@color/text_primary"
                android:paddingVertical="8dp" />

            <Switch
                android:id="@+id/voskWakeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vosk yedek motoru (ayrı aç/kapat)"
                android:textColor="@color/text_primary"
                android:paddingVertical="8dp" />

            <EditText
                android:id="@+id/wakeWordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Uyandırma kelimesi (ör. Eda, Jarvis)"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:inputType="textNoSuggestions"
                android:maxLength="20"
                android:singleLine="true"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not: Çevrimdışı model İngilizcedir; yaygın İngilizce kelimeler daha iyi tanınabilir."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- CARD: Offline Gemma models -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_settings"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠  GEMMA ÇEVRİMDIŞI MODELLER"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/purple_end"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/gemmaDurum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Model durumu kontrol ediliyor..."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/gemma3ModelImport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gemma 3 1B GGUF içe aktar" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not: Model dosyası GGUF biçiminde olmalı. Ollama'nın özel klasöründeki blob dosyaları otomatik olarak görünmez; dosyayı önce telefonun ortak depolamasına kopyala."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Kaydet butonu -->
        <Button
            android:id="@+id/kaydetButon"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="💾  AYARLARI KAYDET"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_purple"
            android:elevation="6dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>
