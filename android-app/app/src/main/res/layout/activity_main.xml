<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0B1E">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="E · D · A"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/durumText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💤 Servis çalışmıyor"
        android:textSize="16sp"
        android:textColor="#B8AEDB"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/baslatButon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Eda'yı Başlat" />

    <Button
        android:id="@+id/durdurButon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Eda'yı Durdur" />

    <!-- ═══ داشبورد + کنترل پنل ═══ -->
    <Button
        android:id="@+id/dashboardButon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="📊 Dashboard"
        android:backgroundTint="#9C27B0" />

    <Button
        android:id="@+id/panelButon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="🎛 Kontrol Paneli"
        android:backgroundTint="#00BCD4" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ayarlar"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/kullaniciAdiInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Hitap (örn. denizçim)"
        android:textColorHint="#8A7FB0"
        android:textColor="#FFFFFF" />

    <EditText
        android:id="@+id/groqInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Groq API anahtarı"
        android:textColorHint="#8A7FB0"
        android:textColor="#FFFFFF"
        android:inputType="textPassword" />

    

    

    <EditText
        android:id="@+id/navasanInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Navasan (dolar/altın) API anahtarı"
        android:textColorHint="#8A7FB0"
        android:textColor="#FFFFFF"
        android:inputType="textPassword" />

    <!-- ═══ تنظیمات پیشرفته ═══ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تنظیمات پیشرفته"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp" />

    <!-- Battery Notifier (bağımsız servis) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔋 Pil izleyici (EDA kapalıyken de çalışır)"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/batteryNotifierSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Derin Uyku -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛌 Derin Uyku (میکروفون خاموش، مصرف ~1%)"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/derinUykuSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Pil Bildirim Araligi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔋 Pil bildirim aralığı"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/pilBildirimSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="100dp" />
    </LinearLayout>

    <!-- Pil Bildirim Aktif -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔔 Pil bildirimi aktif"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/pilBildirimSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Sessiz Mod -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔇 Sessiz mod"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sessizModSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <Button
        android:id="@+id/kaydetButon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Ayarları Kaydet" />

</LinearLayout>
</ScrollView>
