<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#101010"
    android:gravity="center"
    android:showDividers="none">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EDA"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:id="@+id/btn_baslat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:background="#242424">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶" android:textColor="#FFFFFF" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Başlat" android:textColor="#FFFFFF" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_durdur"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:background="#242424">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="■" android:textColor="#FFFFFF" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Durdur" android:textColor="#FFFFFF" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_uyku"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:background="#242424">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zz" android:textColor="#FFFFFF" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Uyku" android:textColor="#FFFFFF" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:paddingTop="4dp">

        <LinearLayout
            android:id="@+id/btn_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:background="#242424">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☷" android:textColor="#FFFFFF" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Panel" android:textColor="#FFFFFF" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_durum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:background="#242424">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textColor="#FFFFFF" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Durum" android:textColor="#FFFFFF" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
